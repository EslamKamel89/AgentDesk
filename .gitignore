.venv/
venv/
env/
ENV/
.python-version

# Packaging and build artifacts
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Environment variables and secrets
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
*.p12
*.pfx
secrets.json
credentials.json

# Django
*.log
db.sqlite3
db.sqlite3-journal
local_settings.py
staticfiles/
media/
uploads/

