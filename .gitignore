agent_logs/
conversation_dumps/
llm_traces/
*.jsonl

# Jupyter notebooks
.ipynb_checkpoints/

# IDE and editor settings
.idea/
.vscode/
*.swp
*.swo
*~

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

